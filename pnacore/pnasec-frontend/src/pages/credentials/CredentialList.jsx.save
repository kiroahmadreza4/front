
import { useState, useEffect } from 'react'
import {
  Container,
  Typography,
  Paper,
  Box,
  CircularProgress,
  Alert,
  Button,
  TextField,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  IconButton,
  Tooltip,
  Snackbar,
  FormControl,
  InputLabel,
  Select,
  MenuItem,
  Chip,
} from '@mui/material'
import {
  Add as AddIcon,
  Delete as DeleteIcon,
  Refresh as RefreshIcon,
} from '@mui/icons-material'
import { DataGrid } from '@mui/x-data-grid'
import api from '../../services/api'

const CredentialList = () => {
  const [credentials, setCredentials] = useState([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState(null)
  const [openDialog, setOpenDialog] = useState(false)
  const [formData, setFormData] = useState({
    name: '',
    type: 'ssh',
    username: '',
    password: '',
    port: 22,
    description: '',
  })
  const [snackbar, setSnackbar] = useState({ open: false, message: '', severity: 'success' })

  const columns = [
    { field: 'name', headerName: 'نام', width: 180 },
    { field: 'type', headerName: 'نوع', width: 120 },
    { field: 'username', headerName: 'کاربر', width: 150 },
    { field: 'port', headerName: 'پورت', width: 100 },
    {
      field: 'is_active',
      headerName: 'وضعیت',
      width: 120,
      renderCell: (params) => (
        <Chip
          label={params.value ? 'فعال' : 'غیرفعال'}
          color={params.value ? 'success' : 'default'}
          size="small"
        />
      ),
    },
    {
      field: 'actions',
      headerName: 'عملیات',
      width: 100,
      sortable: false,
      renderCell: (params) => (
        <Tooltip title="حذف">
          <IconButton size="small" color="error" onClick={() => handleDelete(params.row.id)}>
            <DeleteIcon />
          </IconButton>
        </Tooltip>
      ),
    },
  ]

  const fetchCredentials = async () => {
    setLoading(true)
    setError(null)
    try {
      const response = await fetch('/credentials.json')
      const data = await response.json()
      setCredentials(data)
    } catch (err) {
      setError('خطا در دریافت اطلاعات')
    } finally {
      setLoading(false)
    }
  }

  const handleCreate = async () => {
    try {
      await api.post('/api/v1/credentials/', formData)
      setSnackbar({ open: true, message: '✅ Credential با موفقیت اضافه شد', severity: 'success' })
      setOpenDialog(false)
      setFormData({ name: '', type: 'ssh', username: '', password: '', port: 22, description: '' })
      fetchCredentials()
    } catch (err) {
      setSnackbar({ open: true, message: '❌ خطا: ' + err.message, severity: 'error' })
    }
  }

  const handleDelete = async (id) => {
    if (!window.confirm('آیا از حذف این Credential مطمئن هستید؟')) return
    try {
      await api.delete(`/api/v1/credentials/${id}`)
      setSnackbar({ open: true, message: '🗑️ Credential حذف شد', severity: 'success' })
      fetchCredentials()
    } catch (err) {
      setSnackbar({ open: true, message: '❌ خطا در حذف: ' + err.message, severity: 'error' })
    }
  }

  useEffect(() => {
    fetchCredentials()
  }, [])

  if (loading) {
    return (
      <Box sx={{ display: 'flex', justifyContent: 'center', py: 8 }}>
        <CircularProgress size={60} />
      </Box>
    )
  }

  return (
    <Container maxWidth="xl" sx={{ py: 4 }}>
      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 3 }}>
        <Typography variant="h4" sx={{ fontWeight: 'bold' }}>
          🔐 مدیریت Credential
        </Typography>
        <Box>
          <Button
            variant="outlined"
            startIcon={<RefreshIcon />}
            onClick={fetchCredentials}
            sx={{ mr: 1 }}
          >
            بروزرسانی
          </Button>
          <Button
            variant="contained"
            startIcon={<AddIcon />}
            onClick={() => setOpenDialog(true)}
          >
            افزودن Credential
          </Button>
        </Box>
      </Box>

      {error && <Alert severity="error" sx={{ mb: 3 }}>{error}</Alert>}

      <Paper sx={{ height: 500, width: '100%' }}>
        <DataGrid
          rows={credentials}
          columns={columns}
          getRowId={(row) => row.id}
          loading={loading}
          pageSizeOptions={[5, 10, 25]}
          initialState={{ pagination: { paginationModel: { pageSize: 10 } } }}
        />
      </Paper>

      <Dialog open={openDialog} onClose={() => setOpenDialog(false)} maxWidth="sm" fullWidth>
        <DialogTitle>➕ افزودن Credential جدید</DialogTitle>
        <DialogContent>
          <TextField
            margin="dense"
            label="نام"
            fullWidth
            value={formData.name}
            onChange={(e) => setFormData({ ...formData, name: e.target.value })}
          />
          <FormControl fullWidth margin="dense">
            <InputLabel>نوع</InputLabel>
            <Select
              value={formData.type}
              onChange={(e) => setFormData({ ...formData, type: e.target.value })}
              label="نوع"
            >
              <MenuItem value="ssh">SSH</MenuItem>
              <MenuItem value="winrm">WinRM</MenuItem>
              <MenuItem value="snmp">SNMP</MenuItem>
              <MenuItem value="api">API</MenuItem>
            </Select>
          </FormControl>
          <TextField
            margin="dense"
            label="کاربر"
            fullWidth
            value={formData.username}
            onChange={(e) => setFormData({ ...formData, username: e.target.value })}
          />
          <TextField
            margin="dense"
            label="رمز عبور"
            fullWidth
            type="password"
            value={formData.password}
            onChange={(e) => setFormData({ ...formData, password: e.target.value })}
          />
          <TextField
            margin="dense"
            label="پورت"
            fullWidth
            type="number"
            value={formData.port}
            onChange={(e) => setFormData({ ...formData, port: parseInt(e.target.value) || 22 })}
          />
          <TextField
            margin="dense"
            label="توضیحات"
            fullWidth
            multiline
            rows={2}
            value={formData.description}
            onChange={(e) => setFormData({ ...formData, description: e.target.value })}
          />
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setOpenDialog(false)}>انصراف</Button>
          <Button onClick={handleCreate} variant="contained" color="primary">
            ذخیره
          </Button>
        </DialogActions>
      </Dialog>

      <Snackbar
        open={snackbar.open}
        autoHideDuration={4000}
        onClose={() => setSnackbar({ ...snackbar, open: false })}
        anchorOrigin={{ vertical: 'bottom', horizontal: 'left' }}
      >
        <Alert severity={snackbar.severity}>{snackbar.message}</Alert>
      </Snackbar>
    </Container>
  )
}

export default CredentialList
